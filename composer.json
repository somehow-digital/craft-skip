{
	"name": "somehow-digital/craft-skip",
	"description": "Disable auto-reloading of Twig templates in production.",
	"license": "MIT",
	"type": "craft-plugin",
	"keywords": [
		"twig",
		"template",
		"cache",
		"config",
		"reload",
		"performance"
	],
	"authors": [
		{
			"name": "Thomas Deinhamer",
			"email": "code@thasmo.dev",
			"homepage": "https://thasmo.com/"
		}
	],
	"homepage": "https://somehow.digital/",
	"support": {
		"email": "support@somehow.digital",
		"issues": "https://github.com/somehow-digital/craft-skip/issues",
		"source": "https://github.com/somehow-digital/craft-skip",
		"docs": "https://github.com/somehow-digital/craft-skip"
	},
	"require": {
		"php": "^8.2",
		"craftcms/cms": "^5.8.0"
	},
	"require-dev": {
		"craftcms/phpstan": "dev-main",
		"deptrac/deptrac": "^4.7",
		"ergebnis/composer-normalize": "^2.56",
		"pestphp/pest": "^3.0 || ^4.0",
		"phpat/phpat": "^0.12.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.0 || ^12.0",
		"rector/rector": "^2.0",
		"roave/security-advisories": "dev-latest",
		"shipmonk/composer-dependency-analyser": "^1.8",
		"shipmonk/phpstan-rules": "^4.0",
		"symfony/process": "^7.0 || ^8.0",
		"symplify/easy-coding-standard": "^13.3.17",
		"tomasvotruba/cognitive-complexity": "^1.3"
	},
	"autoload": {
		"psr-4": {
			"SomehowDigital\\Craft\\Skip\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SomehowDigital\\Craft\\Skip\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"ergebnis/composer-normalize": true,
			"pestphp/pest-plugin": true,
			"yiisoft/yii2-composer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"extra": {
		"branch-alias": {
			"dev-main": "1.x-dev"
		},
		"class": "SomehowDigital\\Craft\\Skip\\Skip",
		"handle": "skip",
		"name": "Skip"
	},
	"scripts": {
		"check": [
			"@composer-normalize",
			"@ecs",
			"@rector",
			"@phpstan",
			"@deptrac",
			"@phpat",
			"@deps",
			"@test",
			"@coverage",
			"@mutate"
		],
		"composer-normalize": "@composer normalize --dry-run --diff --no-check-lock --no-update-lock \"$(pwd)/composer.json\"",
		"composer-normalize-fix": "@composer normalize --no-check-lock --no-update-lock \"$(pwd)/composer.json\"",
		"coverage": "pest --coverage --min=100",
		"deps": "composer-dependency-analyser",
		"deptrac": [
			"deptrac analyse --no-progress",
			"deptrac debug:unassigned"
		],
		"ecs": "ecs check",
		"ecs-fix": "ecs check --fix",
		"mutate": "pest --mutate --everything --covered-only --parallel --min=100",
		"phpat": "phpstan analyse --configuration=phpat.neon --memory-limit=1G",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"rector": "rector process --dry-run",
		"rector-fix": "rector process",
		"test": "pest"
	}
}
